# Base URL of the Activity Ranking API under test.
ACTIVITY_RANKING_API_URL=http://127.0.0.1:3000
# Request timeout in milliseconds.
API_REQUEST_TIMEOUT_MS=10000
# Port the test-owned Open-Meteo stub listens on. The API under test must use
# OPEN_METEO_BASE_URL=http://127.0.0.1:<this port> (set on the API, not on the tests).
OPEN_METEO_STUB_PORT=4010
